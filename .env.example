# Puerto HTTP donde se levanta la API de NestJS
PORT=3000

# Orígenes permitidos por CORS separados por coma (ej. http://localhost:5173 para Vite o * en desarrollo)
CORS_ORIGINS=http://localhost:5173

# Host o IP del servidor PostgreSQL
DB_HOST=localhost
# Puerto de PostgreSQL (por defecto 5432)
DB_PORT=5432
# Usuario de la base de datos PostgreSQL
DB_USER=postgres
# Contraseña del usuario de PostgreSQL
DB_PASSWORD=postgres
# Nombre de la base de datos de SmartPet
DB_NAME=smartpet

# Clave secreta para firmar los tokens JWT (usar un valor largo y aleatorio en producción)
JWT_SECRET=cambia_este_secreto_en_produccion
# Tiempo de expiración del token JWT (ej. 15m, 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Cloudinary: credenciales privadas del backend para subir/eliminar fotografías.
# Obligatorias: el backend valida su presencia al iniciar y falla si están vacías.
# Obtener los valores en la consola de Cloudinary; no usar prefijo VITE_ ni publicar el API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
