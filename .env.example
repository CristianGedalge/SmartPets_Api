# Puerto HTTP donde se levanta la API de NestJS
PORT=3000

# Orígenes permitidos por CORS separados por coma (ej. http://localhost:5173 para Vite o * en desarrollo)
CORS_ORIGINS=http://localhost:5173

# Host o IP del servidor PostgreSQL
DB_HOST=localhost
# Puerto de PostgreSQL (por defecto 5432)
DB_PORT=5432
# Usuario de la base de datos PostgreSQL
DB_USER=postgres
# Contraseña del usuario de PostgreSQL
DB_PASSWORD=postgres
# Nombre de la base de datos de SmartPet
DB_NAME=smartpet

# Clave secreta para firmar los tokens JWT (usar un valor largo y aleatorio en producción)
JWT_SECRET=cambia_este_secreto_en_produccion
# Tiempo de expiración del token JWT (ej. 15m, 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Cloudinary: credenciales privadas del backend para subir/eliminar fotografías.
# Obligatorias: el backend valida su presencia al iniciar y falla si están vacías.
# Obtener los valores en la consola de Cloudinary; no usar prefijo VITE_ ni publicar el API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Servicio Python interno de búsqueda visual. Dejar ambos vacíos para deshabilitarlo.
# En local: http://127.0.0.1:8001. No es la URL del móvil.
IA_SERVICE_URL=
# Mismo token privado que en smartpet_ia/.env, mínimo 32 caracteres.
IA_SERVICE_TOKEN=
# Similitud coseno mínima para mostrar una posible coincidencia (0 a 1).
# 0.60 es el punto de partida conservador; ajústalo únicamente con validación de fotos reales.
IA_MIN_SIMILARITY=0.60

# Amazon Bedrock: configuración del asistente de IA (Landing, Cliente Móvil y Reportes Admin)
# Región de AWS donde está habilitado Bedrock (ej. us-east-1)
AWS_REGION=us-east-1
# Clave de API de larga duración generada en la consola de Amazon Bedrock (Claves de API)
AWS_BEARER_TOKEN_BEDROCK=
# Identificador del modelo o perfil de inferencia en Bedrock (por defecto Amazon Nova Lite)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Brevo: envío de correos transaccionales por API HTTP
# Clave API generada en Brevo (SMTP y API -> Claves API, empieza con xkeysib-...)
BREVO_API_KEY=
# Correo remitente verificado en Brevo (ej. correo @gmail.com registrado en Brevo)
BREVO_SENDER_EMAIL=
# Nombre visible del remitente en los correos enviados
BREVO_SENDER_NAME=SmartPet
# Correo que recibe los mensajes del formulario empresarial
CONTACT_RECIPIENT_EMAIL=cristian.gedalge2018@gmail.com
# Sitio empresarial usado en los enlaces de Términos y Privacidad enviados por correo
PUBLIC_WEB_URL=https://smartpet.gedalge.dev

# Firebase Cloud Messaging. Configura las tres variables o déjalas vacías para deshabilitar push.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clave PEM de la cuenta de servicio en una sola línea, conservando los caracteres \n.
FIREBASE_PRIVATE_KEY=
