{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "<rootDir>/ts-jest-cjs.cjs"
  },
  "transformIgnorePatterns": [
    "node_modules[\\\\/](?!@nestjs[\\\\/](jwt|mapped-types|typeorm|passport|config))"
  ]
}
